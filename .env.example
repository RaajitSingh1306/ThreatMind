# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "groq", "together", or "ollama"
# All free — Groq recommended (fastest, most generous free tier)
LLM_PROVIDER=groq

# Groq (free) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Together AI (free tier) — https://api.together.xyz
TOGETHER_API_KEY=your-together-api-key-here
TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf

# Ollama (fully local, no key needed) — https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── NVD API (free, no key required but rate-limited) ─────────────────────────
# Optional key for higher rate limits — https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ─── Data Paths ───────────────────────────────────────────────────────────────
DATA_RAW_DIR=archive
DATA_PROCESSED_DIR=data/processed
CVE_CORPUS_DIR=data/cve_corpus
MODEL_DIR=models

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=threatmind_cves

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT=threatmind-v1

# ─── FastAPI ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── AWS (optional — leave empty for local mode) ──────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
